<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备信息"
            android:textColor="#4FC3F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_run_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="一键全量自检（exec+Python+pip）" />

        <Button
            android:id="@+id/btn_exec_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="运行 exec 自检（场景 1+2）" />

        <TextView
            android:id="@+id/exec_test_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#A5D6A7"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_python_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Python 自检（import 核心模块）" />

        <Button
            android:id="@+id/btn_pip_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="pip 自检（--version）" />

        <Button
            android:id="@+id/btn_phantom_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="幻影进程压测（fork 40×sleep）" />

        <TextView
            android:id="@+id/phantom_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:text="启动后等待 5 分钟，回到终端执行: ps -A | grep -c sleep&#10;若远小于 40，说明被幻影杀手清理；用下方 ADB 命令关闭后复测。" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ADB 缓解命令（在电脑端执行）"
            android:textColor="#4FC3F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adb_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#FFCC80"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_copy_adb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="复制 ADB 命令" />

        <Button
            android:id="@+id/btn_export_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="导出诊断日志到 Android/data" />

        <Button
            android:id="@+id/btn_list_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="查看日志文件列表" />

        <Button
            android:id="@+id/btn_copy_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="复制全部诊断信息" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="包管理器"
            android:textColor="#4FC3F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:text="从 GitHub Releases 仓库拉取索引，安装/更新包及其依赖。" />

        <Button
            android:id="@+id/btn_refresh_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="刷新包索引" />

        <Button
            android:id="@+id/btn_open_pkg_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开包列表（已装/可升级/安装）" />

        <TextView
            android:id="@+id/pkg_index_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E1E1E"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#A5D6A7"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_install_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="安装包（输入包名）" />

        <Button
            android:id="@+id/btn_uninstall_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="卸载包（输入包名）" />
    </LinearLayout>
</ScrollView>
